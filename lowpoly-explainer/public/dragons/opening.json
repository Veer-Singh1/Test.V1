 "captions": [
  {
   "from": 17,
   "to": 34,
   "text": "In the year 793, England's chroniclers"
  },
  {
   "from": 36,
   "to": 82,
   "text": "recorded something terrifying."
  },
  {
   "from": 84,
   "to": 159,
   "text": "\"Immense sheets of light rushing through the air,"
  },
  {
   "from": 161,
   "to": 202,
   "text": "and whirlwinds, and fiery dragons"
  },
  {
   "from": 204,
   "to": 255,
   "text": "flying across the firmament.\""
  },
  {
   "from": 257,
   "to": 321,
   "text": "Soon after, the Vikings came."
  },
  {
   "from": 322,
   "to": 388,
   "text": "They struck the holy island of Lindisfarne,"
  },
  {
   "from": 389,
   "to": 474,
   "text": "and the chronicle remembered those dragons as a warning."
  },
  {
   "from": 476,
   "to": 587,
   "text": "So what did medieval people actually believe a dragon was?"
  },
  {
   "from": 589,
   "to": 668,
   "text": "The answer is stranger than any movie."
  }
 ],
