      "line1": "NO BROKEN",
      "red": "LOCKS.",
      "on_word": "breaking",
      "line2": "LOCKS."
     }
    }
   ]
  },
  {
   "type": "night",
   "sentences": [
    {
     "text": "January 17th, 1950.",
     "shot": {
      "scene": "plate",
      "camera": "push_in",
      "time": "night",
