      "label": "IN CASH ALONE",
      "on_word": "1.2",
      "prefix": "$",
      "suffix": " MILLION",
      "decimals": 1
     }
    },
    {
     "text": "Almost 3 million in all.",
     "shot": {
      "scene": "plate",
      "camera": "push_in",
      "time": "night",
      "plate": "A4b",
      "keep": true
     },
     "overlay": {
