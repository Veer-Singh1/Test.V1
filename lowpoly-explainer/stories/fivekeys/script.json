      "value": 2.7,
      "label": "TAKEN IN ALL",
      "on_word": "3",
      "prefix": "$",
      "suffix": " MILLION",
      "decimals": 1
     }
    },
    {
     "text": "At 7:37, a worker gets free and raises the alarm.",
