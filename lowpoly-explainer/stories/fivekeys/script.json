      "cut": true
     }
    }
   ]
  },
  {
   "type": "pact",
   "sentences": [
    {
     "text": "Then the crew makes a pact.",
     "shot": {
      "scene": "plate",
      "camera": "push_in",
      "time": "night",
      "plate": "F1"
     }
    },
    {
     "text": "Nobody spends, nobody talks, for six years.",
     "shot": {
      "scene": "plate",
      "camera": "track_right",
      "time": "night",
      "plate": "F2",
      "move": 0.4
     },
     "overlay": {
      "kind": "badge",
      "value": 6,
      "label": "YEARS OF SILENCE",
      "on_word": "six"
     }
    },
    {
     "text": "After that, they can never be charged.",
     "shot": {
      "scene": "plate",
      "camera": "push_in",
      "time": "night",
      "plate": "C2"
     }
    },
    {
     "text": "It almost works.",
     "shot": {
      "scene": "plate",
      "camera": "push_in",
      "time": "night",
      "plate": "A6",
      "keep": true,
      "move": 0.75
     },
     "overlay": {
      "kind": "kicker",
      "line1": "ALMOST.",
      "red": "ALMOST.",
      "on_word": "almost"
     }
    }
   ]
  },
  {
   "type": "turn",
   "sentences": [
    {
     "text": "One of them, Specs O'Keefe, goes to jail for a different burglary and wants his share.",
     "shot": {
      "scene": "plate",
      "camera": "push_in",
      "time": "night",
      "plate": "G1",
      "move": 0.55
     },
     "overlay": {
      "kind": "nametag",
      "name": "JOSEPH \"SPECS\" O'KEEFE",
      "place": "ONE OF THE CREW",
      "on_word": "O'Keefe,"
     }
    },
    {
     "text": "Instead, the crew hires a hitman.",
     "shot": {
      "scene": "plate",
      "camera": "track_left",
      "time": "night",
      "plate": "A7"
     }
    },
    {
     "text": "O'Keefe is shot, and survives.",
     "shot": {
      "scene": "plate",
      "camera": "push_in",
      "time": "night",
      "plate": "A8"
     },
     "overlay": {
      "kind": "kicker",
      "line1": "HE",
      "red": "SURVIVES.",
      "on_word": "survives",
      "line2": "SURVIVES."
     }
    },
    {
     "text": "On January 6th, 1956, eleven days before the deadline,",
     "shot": {
      "scene": "plate",
      "camera": "push_in",
      "time": "night",
      "plate": "C3"
     }
    },
    {
     "text": "he tells the FBI everything.",
     "shot": {
      "scene": "plate",
      "camera": "track_right",
      "time": "night",
      "plate": "G2"
     }
    }
   ]
  },
  {
   "type": "end",
   "sentences": [
    {
     "text": "Six days later, agents arrest six men.",
     "shot": {
      "scene": "plate",
      "camera": "push_in",
      "time": "night",
      "plate": "A9"
     },
     "overlay": {
      "kind": "badge",
      "value": 6,
      "label": "MEN ARRESTED",
      "on_word": "six"
     }
    },
    {
     "text": "Five days to spare.",
     "shot": {
      "scene": "plate",
      "camera": "push_in",
      "time": "night",
      "plate": "C4",
      "keep": true
     },
     "overlay": {
      "kind": "badge",
      "value": 5,
      "label": "DAYS TO SPARE",
      "on_word": "Five"
     }
    },
    {
     "text": "Eight men get life in prison.",
