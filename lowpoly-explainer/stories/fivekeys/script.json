 "beats": [
  {
   "type": "hook",
   "sentences": [
    {
     "text": "Did you know the biggest robbery in American history, at the time,",
     "shot": {
      "scene": "plate",
      "camera": "push_in",
      "time": "night",
      "plate": "E1"
     }
    },
    {
     "text": "took less than half an hour,",
     "shot": {
      "scene": "plate",
      "camera": "push_in",
      "time": "night",
      "plate": "A4"
     },
     "overlay": {
      "kind": "badge",
      "value": 27,
      "label": "MINUTES, DOOR TO ALARM",
      "on_word": "half"
     }
    },
    {
     "text": "and the men who did it walked through five locked doors",
     "shot": {
      "scene": "plate",
      "camera": "push_in",
      "time": "night",
      "plate": "B1"
     }
    },
    {
     "text": "without breaking a single one?",
