  {
   "type": "robbery",
   "sentences": [
    {
     "text": "Upstairs, Brink's workers are counting the day's money.",
     "shot": {
      "scene": "plate",
      "camera": "push_in",
      "time": "night",
      "plate": "D1",
      "move": 0.85
     }
    },
    {
     "text": "Within minutes they're tied up and gagged.",
     "shot": {
      "scene": "plate",
      "camera": "track_left",
      "time": "night",
      "plate": "D2"
     }
    },
    {
     "text": "The crew fills bag after bag.",
     "shot": {
      "scene": "plate",
      "camera": "push_in",
      "time": "night",
      "plate": "E2"
     }
    },
    {
     "text": "More than 1.2 million dollars in cash.",
     "shot": {
      "scene": "plate",
      "camera": "pull_out",
      "time": "night",
      "plate": "E3"
     },
     "overlay": {
