      "on_word": "Months",
      "line2": "EARLIER"
     }
    },
    {
     "text": "took the locks out of five doors,",
     "shot": {
      "scene": "plate",
      "camera": "push_in",
      "time": "night",
      "plate": "B4",
      "anchor": [
       0.5,
       0.45
