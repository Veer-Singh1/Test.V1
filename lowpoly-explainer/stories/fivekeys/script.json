      "line2": "1950"
     }
    },
    {
     "text": "Boston."
    },
    {
     "text": "Just after seven, a green Ford truck pulls up on Prince Street.",
     "shot": {
      "scene": "plate",
      "camera": "push_in",
      "time": "night",
      "clip": "street",
      "anchor": [
       0.42,
       0.63
      ],
      "move": 0.55
     }
    },
    {
     "text": "The men wear navy pea coats, chauffeur caps"
    },
    {
     "text": "and rubber Halloween masks.",
     "shot": {
