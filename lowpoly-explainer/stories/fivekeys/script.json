      "camera": "track_right",
      "time": "night",
      "plate": "A3",
      "keep": true
     },
     "overlay": {
      "kind": "kicker",
      "line1": "HALLOWEEN",
      "red": "MASKS.",
      "on_word": "Halloween",
      "cut": true,
      "line2": "MASKS."
     }
    }
   ]
  },
  {
   "type": "secret",
   "sentences": [
    {
     "text": "Months earlier, they slipped into this building at night,",
